<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:theme="@style/AppTheme" android:label="One Tap Test Target" android:allowBackup="false">
        <activity android:name=".TestTargetActivity" android:screenOrientation="portrait" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name=".TestStateProvider"
            android:authorities="com.rallyhelper.testtarget.state"
            android:exported="true" />
    </application>
</manifest>
